---
import { readFileSync } from "fs";
import { join } from "path";
import ConstraintCostsCard from "../components/ConstraintCostsCard.astro";
import OffshoreWindCard from "../components/OffshoreWindCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const dataPath = join(process.cwd(), "data/constraint-costs/headline.json");
const headline = JSON.parse(readFileSync(dataPath, "utf-8"));

const offshorePath = join(process.cwd(), "data/offshore-wind/headline.json");
const offshore = JSON.parse(readFileSync(offshorePath, "utf-8"));

---

<BaseLayout>
  <div class="page-intro">
    <h1 class="page-heading">Infrastructure tracker</h1>
    <p class="page-sub">
      Progress against UK 2030 targets, scored at current build rates.
      Data refreshes monthly. <a href="/methodology">Methodology ↗</a>
    </p>
  </div>

  <section class="tracker-section" aria-labelledby="scored-heading">
    <h2 class="section-label" id="scored-heading">Scored metrics</h2>
    <div class="card-grid">
      <OffshoreWindCard data={offshore} />
    </div>
  </section>

  <section class="tracker-section" aria-labelledby="context-heading">
    <h2 class="section-label" id="context-heading">Context metrics</h2>
    <div class="card-grid">
      <ConstraintCostsCard data={headline} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro {
    margin-bottom: 2.5rem;
  }

  .page-heading {
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 500;
    font-style: italic;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .page-sub {
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .page-sub a {
    color: var(--accent-green);
    text-decoration: none;
  }

  .tracker-section { margin-bottom: 3rem; }

  .section-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-green);
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }
</style>

