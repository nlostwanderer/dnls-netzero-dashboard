---
interface Props {
  data: {
    fy_label: string;
    thermal_cost_gbp: number;
    thermal_cost_gbp_formatted: string;
    row_count: number;
    expected_row_count: number;
    first_date: string;
    data_through: string;
    generated_on: string;
    source_url: string;
    caveats: string[];
    methodology_ref: string;
    fy_totals: { fy: string; total: number; row_count: number }[];
  };
}

const { data } = Astro.props;

const fyDisplay = data.fy_label.replaceAll("-", "–");
const dataThrough = new Date(data.data_through).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
const generatedOn = new Date(data.generated_on).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});

const hasCaveats = data.caveats && data.caveats.length > 0;

const sparkData = data.fy_totals.map((d) => ({
  fy: d.fy.slice(2, 4) + "–" + d.fy.slice(7, 9),
  value: d.total / 1_000_000_000,
}));

const sparkMax = Math.max(...sparkData.map((d) => d.value));
const sparkW = 480;
const sparkH = 72;
const sparkPad = 4;

function toY(v: number) {
  return sparkH - sparkPad - (v / sparkMax) * (sparkH - sparkPad * 2);
}
function toX(i: number) {
  return (i / (sparkData.length - 1)) * sparkW;
}

const points = sparkData.map((d, i) => `${toX(i)},${toY(d.value)}`);
const linePath = "M " + points.join(" L ");
const areaPath = linePath + ` L ${sparkW},${sparkH} L 0,${sparkH} Z`;
const lastX = toX(sparkData.length - 1);
const lastY = toY(sparkData[sparkData.length - 1].value);

---

<article class="card">
  <div class="accent-bar"></div>

  <div class="card-type-badge">
    <span class="badge-dot"></span>
    Context — no score
  </div>

  <p class="metric-source">NESO · Thermal constraint costs</p>
  <h2 class="metric-title">Grid constraint costs</h2>

  <div class="headline-row">
    <span class="headline-figure">{data.thermal_cost_gbp_formatted}</span>
  </div>
  <p class="fy-label">FY {fyDisplay} · data through {dataThrough}</p>

  <div class="sparkline-area">
    <p class="sparkline-label">Annual total · FY 2017–18 to 2025–26</p>
    <svg
      viewBox={`0 0 ${sparkW} ${sparkH + 20}`}
      width="100%"
      role="img"
      aria-label="Sparkline of annual thermal constraint costs FY 2017-18 to 2025-26"
    >
      <defs>
        <linearGradient id="sparkGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#EF9F27" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#EF9F27" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d={areaPath} fill="url(#sparkGrad)" />
      <path
        d={linePath}
        fill="none"
        stroke="#EF9F27"
        stroke-width="1.5"
        stroke-linejoin="round"
        stroke-linecap="round"
      />
      <circle cx={lastX} cy={lastY} r="4" fill="#EF9F27" />
      <text x="0" y={sparkH + 16} font-family="DM Mono, monospace" font-size="9" fill="#4a4a52">17–18</text>
      <text x={sparkW - 28} y={sparkH + 16} font-family="DM Mono, monospace" font-size="9" fill="#6b6b72">25–26</text>
      <text x="0" y="10" font-family="DM Mono, monospace" font-size="9" fill="#4a4a52">£{sparkMax.toFixed(1)}bn</text>
    </svg>
  </div>

  {hasCaveats && (
    <div class="caveat-row">
      <span class="caveat-icon" aria-hidden="true">⚠</span>
      <ul class="caveat-list">
        {data.caveats.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  )}

  <div class="divider"></div>

  <div class="meta-row">
    <span class="meta-item">
      Source: <a href={data.source_url} target="_blank" rel="noopener noreferrer">NESO data portal</a>
    </span>
    <span class="meta-item">Retrieved {generatedOn}</span>
    <a class="methodology-link" href="/methodology">methodology ↗</a>
  </div>
</article>

<style>
  .card {
    background: #18181b;
    border: 1px solid #2a2a2e;
    border-radius: 16px;
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
    max-width: 560px;
  }
  .accent-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #ef9f27 0%, #d85a30 50%, #d4537e 100%);
  }
  .card-type-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ef9f27;
    background: rgba(239, 159, 39, 0.1);
    border: 1px solid rgba(239, 159, 39, 0.25);
    border-radius: 4px;
    padding: 3px 8px;
    margin-bottom: 1.25rem;
  }
  .badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ef9f27;
    flex-shrink: 0;
  }
  .metric-source {
    font-size: 12px;
    font-family: "DM Mono", monospace;
    color: #6b6b72;
    letter-spacing: 0.04em;
    margin: 0 0 0.4rem;
  }
  .metric-title {
    font-size: 17px;
    font-weight: 700;
    color: #e8e8ea;
    margin: 0 0 1.25rem;
    line-height: 1.3;
  }
  .headline-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 0.4rem;
  }
  .headline-figure {
    font-family: "DM Mono", monospace;
    font-size: 48px;
    font-weight: 500;
    color: #ef9f27;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .fy-label {
    font-family: "DM Mono", monospace;
    font-size: 12px;
    color: #5b5b62;
    margin: 0 0 1.75rem;
  }
  .sparkline-area { margin-bottom: 1.5rem; }
  .sparkline-label {
    font-size: 10px;
    font-family: "DM Mono", monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4a4a52;
    margin: 0 0 0.5rem;
  }
  .caveat-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    background: rgba(186, 117, 23, 0.07);
    border: 1px solid rgba(186, 117, 23, 0.2);
    border-radius: 8px;
    padding: 10px 12px;
    margin-bottom: 1.25rem;
  }
  .caveat-icon {
    font-size: 13px;
    color: #ba7517;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .caveat-list {
    font-family: "DM Mono", monospace;
    font-size: 11px;
    color: #7a6a45;
    line-height: 1.6;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .divider {
    height: 1px;
    background: #2a2a2e;
    margin: 1.25rem 0;
  }
  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .meta-item {
    font-family: "DM Mono", monospace;
    font-size: 10px;
    color: #4a4a52;
    letter-spacing: 0.06em;
  }
  .meta-item a {
    color: #5dcaa5;
    text-decoration: none;
  }
  .meta-item a:hover { text-decoration: underline; }
  .methodology-link {
    font-family: "DM Mono", monospace;
    font-size: 10px;
    color: #4a4a52;
    text-decoration: none;
    letter-spacing: 0.06em;
  }
  .methodology-link:hover { color: #5dcaa5; }
</style>
